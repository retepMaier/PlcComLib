[
  {
    "Id": "MachineStatus",
    "Name": "Machine Status",
    "Description": "Periodic status update from the PLC",
    "Fields": [
      { "Name": "MachineId",    "DataType": "Word",     "Description": "Unique machine identifier" },
      { "Name": "Status",       "DataType": "Word",     "Description": "Bitmask: bit0=Running, bit1=Error, bit2=Ready" },
      { "Name": "Speed",        "DataType": "Real",     "Description": "Current speed in rpm" },
      { "Name": "Temperature",  "DataType": "Real",     "Description": "Current temperature in degrees C" },
      { "Name": "AlarmCode",    "DataType": "DInt",     "Description": "Active alarm code (0 = no alarm)" },
      { "Name": "Label",        "DataType": "S7String", "MaxStringLength": 20, "Description": "Machine label" }
    ]
  },
  {
    "Id": "SetpointCommand",
    "Name": "Setpoint Command",
    "Description": "Command telegram sent to the PLC to set a new target speed",
    "Fields": [
      { "Name": "CommandId",    "DataType": "DWord",    "Description": "Unique command identifier" },
      { "Name": "TargetSpeed",  "DataType": "Real",     "Description": "Target speed in rpm" },
      { "Name": "TargetTemp",   "DataType": "Real",     "Description": "Target temperature in degrees C" }
    ]
  }
]
