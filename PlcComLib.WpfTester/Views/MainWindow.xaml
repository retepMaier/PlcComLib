<ui:FluentWindow
    x:Class="PlcComLib.WpfTester.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pages="clr-namespace:PlcComLib.WpfTester.Views.Pages"
    Title="{Binding Title}"
    Width="1200"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <Style TargetType="ui:NavigationViewItem">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <ui:NavigationView
            x:Name="RootNavigationView"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            OpenPaneLength="200">

            <ui:NavigationView.Header>
                <ui:TitleBar
                    Title="PlcComLib WPF Tester"
                    ShowMinimize="True"
                    ShowMaximize="True"
                    ShowClose="True"/>
            </ui:NavigationView.Header>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Connections"
                    Icon="{ui:SymbolIcon Symbol=PlugConnected24}"
                    TargetPageType="{x:Type pages:ConnectionsPage}"/>
                <ui:NavigationViewItem
                    Content="Telegrams"
                    Icon="{ui:SymbolIcon Symbol=DocumentBulletList24}"
                    TargetPageType="{x:Type pages:TelegramsPage}"/>
                <ui:NavigationViewItem
                    Content="Logs"
                    Icon="{ui:SymbolIcon Symbol=TextBulletListSquare24}"
                    TargetPageType="{x:Type pages:LogPage}"/>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="v1.0"
                    Icon="{ui:SymbolIcon Symbol=Info24}"
                    IsEnabled="False"/>
            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
