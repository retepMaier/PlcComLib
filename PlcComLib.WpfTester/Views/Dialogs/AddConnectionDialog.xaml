<Window
    x:Class="PlcComLib.WpfTester.Views.Dialogs.AddConnectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PlcComLib.WpfTester.ViewModels"
    xmlns:models="clr-namespace:PlcComLib.WpfTester.Models"
    Title="Add Connection"
    Width="700"
    Height="750"
    MinWidth="600"
    MinHeight="600"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    Background="{DynamicResource ApplicationBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style TargetType="StackPanel" x:Key="FieldGroup">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,16,24,8">
            <StackPanel>

                <!-- Section: Basic -->
                <TextBlock Text="Connection Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Name (optional)" Style="{StaticResource FieldLabel}"/>
                        <ui:TextBox PlaceholderText="My Connection" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Connection Type" Style="{StaticResource FieldLabel}"/>
                        <ComboBox
                            ItemsSource="{Binding ConnectionTypes}"
                            SelectedItem="{Binding SelectedType}"
                            HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Host / IP Address" Style="{StaticResource FieldLabel}"/>
                        <ui:TextBox PlaceholderText="127.0.0.1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                        <ui:NumberBox
                            Minimum="1"
                            Maximum="65535"
                            Value="{Binding Port}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Byte Order" Style="{StaticResource FieldLabel}"/>
                        <ComboBox
                            ItemsSource="{Binding ByteOrders}"
                            SelectedItem="{Binding SelectedByteOrder}"
                            HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Timeout (seconds)" Style="{StaticResource FieldLabel}"/>
                        <ui:NumberBox Minimum="1" Maximum="300" Value="{Binding TimeoutSeconds}"/>
                    </StackPanel>
                </Grid>

                <!-- TCP Client specific -->
                <StackPanel Visibility="{Binding IsTcpClient, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <TextBlock Text="Reconnect Interval (seconds)" Style="{StaticResource FieldLabel}"/>
                    <ui:NumberBox Minimum="1" Maximum="300" Value="{Binding ReconnectIntervalSeconds}"/>
                </StackPanel>

                <!-- TCP Server specific -->
                <StackPanel Visibility="{Binding IsTcpServer, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <TextBlock Text="Max Connections" Style="{StaticResource FieldLabel}"/>
                    <ui:NumberBox Minimum="1" Maximum="1000" Value="{Binding MaxConnections}"/>
                </StackPanel>

                <!-- Advanced -->
                <Expander Header="Advanced Settings" Margin="0,0,0,16">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="No Delay (TCP_NODELAY)" Style="{StaticResource FieldLabel}"/>
                            <CheckBox Content="Enable" IsChecked="{Binding NoDelay}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Receive Buffer (0=default)" Style="{StaticResource FieldLabel}"/>
                            <ui:NumberBox Minimum="0" Maximum="65535" Value="{Binding ReceiveBufferSize}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Send Buffer (0=default)" Style="{StaticResource FieldLabel}"/>
                            <ui:NumberBox Minimum="0" Maximum="65535" Value="{Binding SendBufferSize}"/>
                        </StackPanel>
                    </Grid>
                </Expander>

                <Separator Margin="0,0,0,16"/>

                <!-- Telegrams Section -->
                <TextBlock Text="Telegram Definitions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <!-- Add Telegram Form -->
                <ui:Card Margin="0,0,0,12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Add Telegram" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Telegram Name" Style="{StaticResource FieldLabel}"/>
                                <ui:TextBox PlaceholderText="e.g. HeartbeatMsg" Text="{Binding NewTelegramName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Message ID (hex)" Style="{StaticResource FieldLabel}"/>
                                <ui:NumberBox Minimum="0" Maximum="65535" Value="{Binding NewTelegramMessageId}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="ID Offset" Style="{StaticResource FieldLabel}"/>
                                <ui:NumberBox Minimum="0" Maximum="255" Value="{Binding NewTelegramMessageIdOffset}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="ID Type" Style="{StaticResource FieldLabel}"/>
                                <ComboBox
                                    ItemsSource="{Binding DataTypes}"
                                    SelectedItem="{Binding NewTelegramMessageIdType}"/>
                            </StackPanel>
                        </Grid>
                        <ui:Button
                            Content="Add Telegram"
                            Icon="{ui:SymbolIcon Symbol=Add24}"
                            Appearance="Primary"
                            Command="{Binding AddTelegramCommand}"
                            HorizontalAlignment="Right"/>
                    </StackPanel>
                </ui:Card>

                <!-- Telegram List -->
                <ItemsControl ItemsSource="{Binding Telegrams}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TelegramDefinitionModel}">
                            <ui:Card Margin="0,0,0,8" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Name}"/>
                                                <TextBlock FontSize="13" Opacity="0.6" Margin="4,0,0,0">
                                                    <Run Text=" (ID: 0x"/>
                                                    <Run Text="{Binding MessageId, StringFormat=X4}"/>
                                                    <Run Text=")"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:Button
                                                Content="Select"
                                                Icon="{ui:SymbolIcon Symbol=Edit24}"
                                                Appearance="Secondary"
                                                Margin="0,0,8,0"
                                                Command="{Binding DataContext.SelectTelegramCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                            <ui:Button
                                                Icon="{ui:SymbolIcon Symbol=Delete24}"
                                                Appearance="Danger"
                                                Command="{Binding DataContext.RemoveTelegramCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Fields preview -->
                                    <ItemsControl
                                        ItemsSource="{Binding Fields}"
                                        Margin="0,8,0,0"
                                        Visibility="{Binding DataContext.HasSelectedTelegram, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:TelegramFieldDefinition}">
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    Opacity="0.7">
                                                    <Run Text="  • "/>
                                                    <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding DataType}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add Field Form (shown when a telegram is selected) -->
                <ui:Card
                    Visibility="{Binding HasSelectedTelegram, Converter={StaticResource BoolToVis}}"
                    Padding="12"
                    Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Margin="0,0,0,8">
                            <Run Text="Add Field to: "/>
                            <Run Text="{Binding SelectedTelegram.Name}" FontStyle="Italic"/>
                        </TextBlock>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Field Name" Style="{StaticResource FieldLabel}"/>
                                <ui:TextBox PlaceholderText="e.g. MessageId" Text="{Binding NewFieldName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data Type" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding DataTypes}" SelectedItem="{Binding NewFieldDataType}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>
                        <ui:Button
                            Content="Add Field"
                            Icon="{ui:SymbolIcon Symbol=Add24}"
                            Command="{Binding AddFieldCommand}"
                            HorizontalAlignment="Right"/>

                        <!-- Current Fields -->
                        <ItemsControl ItemsSource="{Binding CurrentTelegramFields}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TelegramFieldDefinition}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="11">
                                            <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <Run Text=" : "/>
                                            <Run Text="{Binding DataType}"/>
                                        </TextBlock>
                                        <ui:Button
                                            Grid.Column="1"
                                            Icon="{ui:SymbolIcon Symbol=Delete24}"
                                            Appearance="Danger"
                                            Padding="4"
                                            Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button
                    Content="Cancel"
                    Margin="0,0,12,0"
                    Click="OnCancelClick"/>
                <ui:Button
                    Content="Create Connection"
                    Icon="{ui:SymbolIcon Symbol=PlugConnected24}"
                    Appearance="Primary"
                    Click="OnCreateClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
