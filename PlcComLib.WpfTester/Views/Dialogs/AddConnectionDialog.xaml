<Window
    x:Class="PlcComLib.WpfTester.Views.Dialogs.AddConnectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PlcComLib.WpfTester.ViewModels"
    Title="Add Connection"
    Width="700"
    Height="700"
    MinWidth="600"
    MinHeight="500"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    Background="{DynamicResource ApplicationBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <Style TargetType="StackPanel" x:Key="FieldGroup">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,16,24,8">
            <StackPanel>

                <!-- Section: Basic -->
                <TextBlock Text="Connection Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Name (optional)" Style="{StaticResource FieldLabel}"/>
                        <ui:TextBox PlaceholderText="My Connection" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Connection Type" Style="{StaticResource FieldLabel}"/>
                        <ComboBox
                            ItemsSource="{Binding ConnectionTypes}"
                            SelectedItem="{Binding SelectedType}"
                            HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Host / IP Address" Style="{StaticResource FieldLabel}"/>
                        <ui:TextBox PlaceholderText="127.0.0.1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                        <ui:NumberBox
                            Minimum="1"
                            Maximum="65535"
                            Value="{Binding Port}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Byte Order" Style="{StaticResource FieldLabel}"/>
                        <ComboBox
                            ItemsSource="{Binding ByteOrders}"
                            SelectedItem="{Binding SelectedByteOrder}"
                            HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Timeout (seconds)" Style="{StaticResource FieldLabel}"/>
                        <ui:NumberBox Minimum="1" Maximum="300" Value="{Binding TimeoutSeconds}"/>
                    </StackPanel>
                </Grid>

                <!-- TCP Client specific -->
                <StackPanel Visibility="{Binding IsTcpClient, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <TextBlock Text="Reconnect Interval (seconds)" Style="{StaticResource FieldLabel}"/>
                    <ui:NumberBox Minimum="1" Maximum="300" Value="{Binding ReconnectIntervalSeconds}"/>
                </StackPanel>

                <!-- TCP Server specific -->
                <StackPanel Visibility="{Binding IsTcpServer, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <TextBlock Text="Max Connections" Style="{StaticResource FieldLabel}"/>
                    <ui:NumberBox Minimum="1" Maximum="1000" Value="{Binding MaxConnections}"/>
                </StackPanel>

                <!-- Advanced -->
                <Expander Header="Advanced Settings" Margin="0,0,0,16">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="No Delay (TCP_NODELAY)" Style="{StaticResource FieldLabel}"/>
                            <CheckBox Content="Enable" IsChecked="{Binding NoDelay}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Receive Buffer (0=default)" Style="{StaticResource FieldLabel}"/>
                            <ui:NumberBox Minimum="0" Maximum="65535" Value="{Binding ReceiveBufferSize}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Send Buffer (0=default)" Style="{StaticResource FieldLabel}"/>
                            <ui:NumberBox Minimum="0" Maximum="65535" Value="{Binding SendBufferSize}"/>
                        </StackPanel>
                    </Grid>
                </Expander>

                <Separator Margin="0,0,0,16"/>

                <!-- Telegrams Section -->
                <TextBlock Text="Assign Telegrams" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock
                    Opacity="0.6"
                    FontSize="12"
                    Margin="0,0,0,12"
                    TextWrapping="Wrap">
                    Select the telegrams from the global library that this connection should use.
                    Manage the telegram library on the <Run FontWeight="SemiBold">Telegrams</Run> page.
                </TextBlock>

                <!-- No telegrams hint -->
                <TextBlock
                    Text="No telegrams are defined yet. Go to the Telegrams page to add them first."
                    Opacity="0.5"
                    FontStyle="Italic"
                    Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAvailableTelegrams}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Telegram checklist -->
                <ItemsControl ItemsSource="{Binding AvailableTelegrams}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="10,8"
                                Margin="0,0,0,4"
                                CornerRadius="6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        Grid.Column="0"
                                        IsChecked="{Binding IsSelected}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Telegram.Name}"/>
                                            <TextBlock Opacity="0.6" Margin="4,0,0,0" FontSize="12">
                                                <Run Text="(ID: 0x"/>
                                                <Run Text="{Binding Telegram.MessageId, StringFormat=X4}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock FontSize="11" Opacity="0.6" FontFamily="Consolas">
                                            <Run Text="{Binding Telegram.Fields.Count}"/>
                                            <Run Text=" field(s)"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button
                    Content="Cancel"
                    Margin="0,0,12,0"
                    Click="OnCancelClick"/>
                <ui:Button
                    Content="Create Connection"
                    Icon="{ui:SymbolIcon Symbol=PlugConnected24}"
                    Appearance="Primary"
                    Click="OnCreateClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
