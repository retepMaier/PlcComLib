<Page
    x:Class="PlcComLib.WpfTester.Views.Pages.TelegramsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:models="clr-namespace:PlcComLib.WpfTester.Models"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Title="Telegrams">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Telegram Library"
                FontSize="24"
                FontWeight="SemiBold"
                VerticalAlignment="Center"/>
            <ui:Button
                Grid.Column="1"
                Content="Import"
                Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                Command="{Binding ImportCommand}"
                VerticalAlignment="Center"/>
            <ui:Button
                Grid.Column="3"
                Content="Export"
                Icon="{ui:SymbolIcon Symbol=Save24}"
                Command="{Binding ExportCommand}"
                VerticalAlignment="Center"/>
        </Grid>

        <!-- Two-column layout: telegram list (left) + field editor (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Telegram list + Add form -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Add Telegram Form -->
                <ui:Card Grid.Row="0" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="New Telegram" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                <ui:TextBox PlaceholderText="e.g. HeartbeatMsg" Text="{Binding NewTelegramName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Message ID" Style="{StaticResource FieldLabel}"/>
                                <ui:NumberBox Minimum="0" Maximum="65535" Value="{Binding NewTelegramMessageId}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="ID Offset" Style="{StaticResource FieldLabel}"/>
                                <ui:NumberBox Minimum="0" Maximum="255" Value="{Binding NewTelegramMessageIdOffset}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="ID Type" Style="{StaticResource FieldLabel}"/>
                                <ComboBox
                                    ItemsSource="{Binding DataTypes}"
                                    SelectedItem="{Binding NewTelegramMessageIdType}"
                                    HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>
                        <ui:Button
                            Content="Add Telegram"
                            Icon="{ui:SymbolIcon Symbol=Add24}"
                            Appearance="Primary"
                            Command="{Binding AddTelegramCommand}"
                            HorizontalAlignment="Right"/>
                    </StackPanel>
                </ui:Card>

                <!-- Telegram List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Telegrams}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TelegramDefinitionModel}">
                                    <ui:Card Margin="0,0,0,8" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Name}"/>
                                                    <TextBlock FontSize="13" Opacity="0.6" Margin="4,0,0,0">
                                                        <Run Text=" (ID: 0x"/>
                                                        <Run Text="{Binding MessageId, StringFormat=X4}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock FontSize="11" Opacity="0.6" FontFamily="Consolas">
                                                    <Run Text="{Binding Fields.Count}"/>
                                                    <Run Text=" field(s)  ·  Offset: "/>
                                                    <Run Text="{Binding MessageIdByteOffset}"/>
                                                    <Run Text="  ·  Type: "/>
                                                    <Run Text="{Binding MessageIdDataType}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button
                                                    Content="Edit Fields"
                                                    Icon="{ui:SymbolIcon Symbol=Edit24}"
                                                    Appearance="Secondary"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding DataContext.SelectTelegramCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                                <ui:Button
                                                    Icon="{ui:SymbolIcon Symbol=Delete24}"
                                                    Appearance="Danger"
                                                    Command="{Binding DataContext.RemoveTelegramCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <TextBlock
                            Text="No telegrams defined yet. Use the form above to add your first telegram."
                            HorizontalAlignment="Center"
                            Opacity="0.5"
                            Margin="0,24,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Telegrams.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Right: Field Editor (shown when a telegram is selected) -->
            <Grid Grid.Column="2">

                <!-- Placeholder when nothing selected -->
                <Border VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedTelegram}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        Text="Click 'Edit Fields' on a telegram&#x0a;to manage its fields here."
                        TextAlignment="Center"
                        Opacity="0.5"/>
                </Border>

                <!-- Field editor (shown when telegram is selected) -->
                <Grid Visibility="{Binding HasSelectedTelegram, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">
                                <Run Text="Fields of: "/>
                                <Run Text="{Binding SelectedTelegram.Name}" FontStyle="Italic"/>
                            </TextBlock>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Field Name" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox
                                        PlaceholderText="e.g. MessageId"
                                        Text="{Binding NewFieldName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Data Type" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox
                                        ItemsSource="{Binding DataTypes}"
                                        SelectedItem="{Binding NewFieldDataType}"
                                        HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                            <ui:Button
                                Content="Add Field"
                                Icon="{ui:SymbolIcon Symbol=Add24}"
                                Command="{Binding AddFieldCommand}"
                                HorizontalAlignment="Right"/>
                        </StackPanel>
                    </ui:Card>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CurrentTelegramFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TelegramFieldDefinition}">
                                    <Border Padding="8,6" Margin="0,2" CornerRadius="4"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="11">
                                                <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <Run Text=" : "/>
                                                <Run Text="{Binding DataType}"/>
                                            </TextBlock>
                                            <ui:Button
                                                Grid.Column="1"
                                                Icon="{ui:SymbolIcon Symbol=Delete24}"
                                                Appearance="Danger"
                                                Padding="4"
                                                Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
