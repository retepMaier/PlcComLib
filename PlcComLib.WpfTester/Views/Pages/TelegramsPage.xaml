<Page
    x:Class="PlcComLib.WpfTester.Views.Pages.TelegramsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:models="clr-namespace:PlcComLib.WpfTester.Models" 
    xmlns:viewmodels="clr-namespace:PlcComLib.WpfTester.ViewModels" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Title="Telegrams">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <!-- Dim disabled controls without changing IsEnabled styling globally -->
        <Style x:Key="DisabledDimStyle" TargetType="Control">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Telegram Library"
                FontSize="24"
                FontWeight="SemiBold"
                VerticalAlignment="Center"/>
            <ui:Button
                Grid.Column="1"
                Content="Import"
                Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                Command="{Binding ImportCommand}"
                VerticalAlignment="Center"/>
            <ui:Button
                Grid.Column="3"
                Content="Export"
                Icon="{ui:SymbolIcon Symbol=Save24}"
                Command="{Binding ExportCommand}"
                VerticalAlignment="Center"/>
        </Grid>

        <!-- Two-column layout: telegram list (left) + field editor (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Telegram list + Add form -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Add Telegram Form -->
                <ui:Card Grid.Row="0" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="New Telegram" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                <ui:TextBox PlaceholderText="e.g. HeartbeatMsg" Text="{Binding NewTelegramName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <ui:Button
                            Content="Add Telegram"
                            Icon="{ui:SymbolIcon Symbol=Add24}"
                            Appearance="Primary"
                            Command="{Binding AddTelegramCommand}"
                            HorizontalAlignment="Right"/>
                    </StackPanel>
                </ui:Card>

                <!-- Telegram List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Telegrams}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TelegramDefinitionModel}">
                                    <ui:Card Margin="0,0,0,8" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Name}"/>
                                                <TextBlock FontSize="11" Opacity="0.6" FontFamily="Consolas">
                                                    <Run Text="{Binding Fields.Count, Mode=OneWay}"/>
                                                    <Run Text=" field(s)"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button
                                                    Content="Edit Fields"
                                                    Icon="{ui:SymbolIcon Symbol=Edit24}"
                                                    Appearance="Secondary"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding DataContext.SelectTelegramCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                                <ui:Button
                                                    Icon="{ui:SymbolIcon Symbol=Delete24}"
                                                    Appearance="Danger"
                                                    Command="{Binding DataContext.RemoveTelegramCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <TextBlock
                            Text="No telegrams defined yet. Use the form above to add your first telegram."
                            HorizontalAlignment="Center"
                            Opacity="0.5"
                            Margin="0,24,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Telegrams.Count, Mode=OneWay}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Right: Field Editor (shown when a telegram is selected) -->
            <Grid Grid.Column="2">

                <!-- Placeholder when nothing selected -->
                <Border VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedTelegram}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        Text="Click 'Edit Fields' on a telegram&#x0a;to manage its fields here."
                        TextAlignment="Center"
                        Opacity="0.5"/>
                </Border>

                <!-- Field editor (shown when telegram is selected) -->
                <Grid Visibility="{Binding HasSelectedTelegram, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Add Field Form -->
                    <ui:Card Grid.Row="0" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">
                                <Run Text="Fields of: "/>
                                <Run Text="{Binding SelectedTelegram.Name}" FontStyle="Italic"/>
                            </TextBlock>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Field Name" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox
                                        PlaceholderText="e.g. Speed"
                                        Text="{Binding NewFieldName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Data Type" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox
                                        ItemsSource="{Binding DataTypes}"
                                        SelectedItem="{Binding NewFieldDataType}"
                                        HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Default Value" Style="{StaticResource FieldLabel}"/>
                                    <ui:TextBox
                                        PlaceholderText="(optional)"
                                        Text="{Binding NewFieldDefaultValue, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <!-- Length: always laid out, disabled+dimmed when not applicable -->
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Length">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NewFieldNeedsLength}" Value="False">
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ui:NumberBox
                                        Value="{Binding NewFieldLength}"
                                        Minimum="0" Maximum="65535"
                                        IsEnabled="{Binding NewFieldNeedsLength}"
                                        Style="{StaticResource DisabledDimStyle}"/>
                                </StackPanel>
                            </Grid>
                            <ui:Button
                                Content="Add Field"
                                Icon="{ui:SymbolIcon Symbol=Add24}"
                                Command="{Binding AddFieldCommand}"
                                HorizontalAlignment="Right"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Field table -->
                    <DataGrid
                        Grid.Row="1"
                        ItemsSource="{Binding CurrentTelegramFields}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserSortColumns="False"
                        SelectionMode="Single"
                        HeadersVisibility="Column"
                        RowHeaderWidth="0"
                        GridLinesVisibility="Horizontal"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">

                        <DataGrid.Resources>
                            <!-- Single-click to start editing a cell -->
                            <Style TargetType="DataGridCell">
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FieldCell_PreviewMouseLeftButtonDown"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <!-- Name -->
                            <DataGridTemplateColumn Header="Name" Width="*" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            VerticalContentAlignment="Center"
                                            Padding="4,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Data Type -->
                            <DataGridTemplateColumn Header="Data Type" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox
                                            ItemsSource="{Binding DataContext.DataTypes, RelativeSource={RelativeSource AncestorType=Page}}"
                                            SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Default Value -->
                            <DataGridTemplateColumn Header="Default Value" Width="*" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox
                                            Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            VerticalContentAlignment="Center"
                                            Padding="4,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Length (only relevant for string / array / raw types) -->
                            <DataGridTemplateColumn Header="Length" Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox
                                            Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding NeedsLength}"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            VerticalContentAlignment="Center"
                                            Padding="4,2"
                                            Style="{StaticResource DisabledDimStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions: Move Up / Move Down / Delete -->
                            <DataGridTemplateColumn Header="" Width="92">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                            <ui:Button
                                                Icon="{ui:SymbolIcon Symbol=ArrowUp24}"
                                                Padding="4"
                                                Margin="0,0,2,0"
                                                ToolTip="Move up"
                                                Command="{Binding DataContext.MoveFieldUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                            <ui:Button
                                                Icon="{ui:SymbolIcon Symbol=ArrowDown24}"
                                                Padding="4"
                                                Margin="0,0,2,0"
                                                ToolTip="Move down"
                                                Command="{Binding DataContext.MoveFieldDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                            <ui:Button
                                                Icon="{ui:SymbolIcon Symbol=Delete24}"
                                                Appearance="Danger"
                                                Padding="4"
                                                ToolTip="Delete field"
                                                Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
