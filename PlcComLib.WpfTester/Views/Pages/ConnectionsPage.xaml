<Page
    x:Class="PlcComLib.WpfTester.Views.Pages.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PlcComLib.WpfTester.ViewModels"
    xmlns:models="clr-namespace:PlcComLib.WpfTester.Models"
    xmlns:views="clr-namespace:PlcComLib.WpfTester.Views.Dialogs"
    Title="Connections">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Connections"
                FontSize="24"
                FontWeight="SemiBold"
                VerticalAlignment="Center"/>
            <ui:Button
                Grid.Column="1"
                Content="Add Connection"
                Icon="{ui:SymbolIcon Symbol=Add24}"
                Appearance="Primary"
                Click="OnAddConnectionClick"/>
        </Grid>

        <!-- Connections List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Connections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConnectionItemViewModel}">
                        <ui:Card Margin="0,0,0,12" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Card Header -->
                                <Border
                                    Grid.Row="0"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="8,8,0,0"
                                    Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Indicator + Info -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse
                                                Width="10" Height="10"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#FF4444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Fill" Value="#44FF44"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel>
                                                <TextBlock
                                                    Text="{Binding DisplayName}"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"/>
                                                <TextBlock
                                                    FontSize="11"
                                                    Opacity="0.7">
                                                    <Run Text="{Binding TypeLabel}"/>
                                                    <Run Text=" | "/>
                                                    <Run Text="{Binding HostPort}"/>
                                                    <Run Text=" | "/>
                                                    <Run Text="{Binding Settings.ByteOrder}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <ui:Badge
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Content="{Binding StatusText}"/>

                                        <!-- Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button
                                                Content="Start"
                                                Icon="{ui:SymbolIcon Symbol=Play24}"
                                                Appearance="Success"
                                                Margin="0,0,8,0"
                                                Command="{Binding StartCommand}">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                            <ui:Button
                                                Content="Stop"
                                                Icon="{ui:SymbolIcon Symbol=Stop24}"
                                                Appearance="Danger"
                                                Margin="0,0,8,0"
                                                Command="{Binding StopConnectionCommand}">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                            <ui:Button
                                                Icon="{ui:SymbolIcon Symbol=Delete24}"
                                                Appearance="Secondary"
                                                Command="{Binding DataContext.RemoveConnectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Send Telegram Section -->
                                <Expander
                                    Grid.Row="1"
                                    Header="Send Telegram"
                                    Margin="0"
                                    Padding="16,8">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox
                                            Grid.Row="0" Grid.Column="0"
                                            Margin="0,0,8,8"
                                            ItemsSource="{Binding Settings.Telegrams}"
                                            SelectedItem="{Binding SelectedTelegram}"
                                            DisplayMemberPath="Name"/>
                                        <ui:Button
                                            Grid.Row="0" Grid.Column="1"
                                            Content="Send Telegram"
                                            Icon="{ui:SymbolIcon Symbol=Send24}"
                                            Appearance="Primary"
                                            Margin="0,0,8,8"
                                            Command="{Binding SendTelegramCommand}"
                                            IsEnabled="{Binding IsConnected}"/>

                                        <ui:TextBox
                                            Grid.Row="1" Grid.Column="0"
                                            Margin="0,0,8,0"
                                            PlaceholderText="Raw hex bytes (e.g. 01 02 FF)"
                                            Text="{Binding SendHex, UpdateSourceTrigger=PropertyChanged}"/>
                                        <ui:Button
                                            Grid.Row="1" Grid.Column="1"
                                            Content="Send Raw"
                                            Icon="{ui:SymbolIcon Symbol=ArrowRight24}"
                                            Margin="0,0,8,0"
                                            Command="{Binding SendRawHexCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                        <ui:Button
                                            Grid.Row="0" Grid.Column="2"
                                            Grid.RowSpan="2"
                                            Content="Clear"
                                            Icon="{ui:SymbolIcon Symbol=Delete24}"
                                            Command="{Binding ClearMessagesCommand}"
                                            VerticalAlignment="Center"/>
                                    </Grid>
                                </Expander>

                                <!-- Messages Section -->
                                <Expander
                                    Grid.Row="2"
                                    Header="{Binding Messages.Count, StringFormat='Messages ({0})'}"
                                    Margin="0"
                                    Padding="16,8">
                                    <Border
                                        Background="{DynamicResource ApplicationBackgroundBrush}"
                                        CornerRadius="4"
                                        MaxHeight="300">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Messages}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:MessageEntry}">
                                                        <Border
                                                            Padding="8,6"
                                                            Margin="0,1"
                                                            CornerRadius="4">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Direction}" Value="Sent">
                                                                            <Setter Property="Background" Value="#1A2050A0"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="70"/>
                                                                    <ColumnDefinition Width="130"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    Text="{Binding DirectionLabel}"
                                                                    FontFamily="Consolas"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#44BB44"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Direction}" Value="Sent">
                                                                                    <Setter Property="Foreground" Value="#4488FF"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"
                                                                    FontFamily="Consolas"
                                                                    FontSize="11"
                                                                    Opacity="0.6"/>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock
                                                                        Text="{Binding HexDisplay}"
                                                                        FontFamily="Consolas"
                                                                        FontSize="11"
                                                                        TextWrapping="Wrap"/>
                                                                    <ItemsControl ItemsSource="{Binding Fields}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock
                                                                                    FontFamily="Consolas"
                                                                                    FontSize="10"
                                                                                    Opacity="0.75">
                                                                                    <Run Text="{Binding Key}" FontWeight="SemiBold"/>
                                                                                    <Run Text=" = "/>
                                                                                    <Run Text="{Binding Value}"/>
                                                                                </TextBlock>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <TextBlock
                                                                        Text="{Binding TelegramName, StringFormat='Telegram: {0}'}"
                                                                        FontSize="10"
                                                                        Opacity="0.5">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding TelegramName}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>

                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Page>
