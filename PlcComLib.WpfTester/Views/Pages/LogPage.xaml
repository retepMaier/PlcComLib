<Page
    x:Class="PlcComLib.WpfTester.Views.Pages.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:models="clr-namespace:PlcComLib.WpfTester.Models"
    Title="Logs">

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Application Logs"
                FontSize="24"
                FontWeight="SemiBold"
                VerticalAlignment="Center"/>
            <ui:ToggleSwitch
                Grid.Column="1"
                Content="Auto-scroll"
                IsChecked="{Binding AutoScroll}"
                Margin="0,0,12,0"
                VerticalAlignment="Center"/>
            <ui:Button
                Grid.Column="2"
                Content="Clear"
                Icon="{ui:SymbolIcon Symbol=Delete24}"
                Command="{Binding ClearCommand}"/>
        </Grid>

        <!-- Log Entries -->
        <ui:Card Grid.Row="1" Padding="0">
            <ScrollViewer
                x:Name="LogScrollViewer"
                VerticalScrollBarVisibility="Auto"
                Padding="8">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LogEntry}">
                            <Border Padding="8,4" Margin="0,1" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter Property="Background" Value="#1AFFA500"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Background" Value="#1AFF4444"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Opacity="0.6"
                                        VerticalAlignment="Center"/>
                                    <TextBlock
                                        Grid.Column="1"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        Text="{Binding Level}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Foreground" Value="Orange"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Foreground" Value="#FF5555"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Info">
                                                        <Setter Property="Foreground" Value="#55AAFF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Debug">
                                                        <Setter Property="Foreground" Value="#AAAAAA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding Source}"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Opacity="0.7"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{Binding Message}"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </ui:Card>
    </Grid>
</Page>
